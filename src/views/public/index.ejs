<!-- Category Gateway & Direct Hardware Catalog -->
<div class="min-h-screen flex flex-col bg-[#0B0F19] text-[#F8FAFC]">
  
  <!-- Minimal Neutral Top Bar -->
  <header class="h-16 px-6 sm:px-10 border-b border-[#1E293B] flex items-center justify-between z-20 bg-[#0B0F19]/90 backdrop-blur-md sticky top-0">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-[#0284C7]/20 border border-[#0284C7]/40 flex items-center justify-center text-[#38BDF8]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M12 2v20M2 12h20"></path>
        </svg>
      </div>
      <div>
        <a href="/" class="font-bold text-base sm:text-lg tracking-tight text-white hover:text-[#38BDF8] transition-colors"><%= settings.business_name %></a>
        <span class="hidden md:inline-block text-xs text-[#94A3B8] ml-2 font-mono">• Direct Importer Catalog</span>
      </div>
    </div>

    <!-- Top Bar Navigation & Search -->
    <div class="flex items-center gap-3 sm:gap-6">
      <nav class="hidden lg:flex items-center gap-5 text-xs font-medium text-[#94A3B8]">
        <a href="#featured-ac" class="hover:text-white transition-colors">Air Conditioners</a>
        <a href="/category/access-points" class="hover:text-white transition-colors">Access Points</a>
        <a href="/offers" class="hover:text-[#EA580C] transition-colors">Deals</a>
        <a href="/contact" class="hover:text-white transition-colors">Showroom</a>
      </nav>

      <form action="/products" method="GET" class="relative hidden sm:block w-48 md:w-60">
        <input 
          type="text" 
          name="q" 
          placeholder="Search ACs, Wi-Fi 6..." 
          class="w-full bg-[#1E293B] border border-[#334155] rounded-lg px-3 py-1.5 pl-8 text-xs text-white placeholder-[#64748B] focus:outline-none focus:border-[#38BDF8]"
        />
        <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-[#64748B]">
          <%- include('../partials/icons', { name: 'search', className: 'w-3.5 h-3.5' }) %>
        </div>
      </form>

      <a 
        href="<%= waLink('', '') %>" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="bg-[#25D366] hover:bg-[#20BA5A] text-white text-xs font-semibold px-3.5 py-1.5 rounded-lg flex items-center gap-1.5 transition-colors"
      >
        <%- include('../partials/icons', { name: 'whatsapp', className: 'w-4 h-4' }) %>
        <span>Instant Quote</span>
      </a>
    </div>
  </header>

  <!-- Interactive 50/50 -> 60/40 Split Screen Gateway Hero with REAL HARDWARE PHOTOGRAPHY -->
  <div class="min-h-[520px] md:min-h-[600px] flex flex-col md:flex-row relative overflow-hidden" id="gateway-container">
    
    <% 
      const acCat = categories.find(c => c.slug === 'air-conditioners') || { product_count: 6 };
      const apCat = categories.find(c => c.slug === 'access-points') || { product_count: 6 };
    %>

    <!-- PANEL A: COOLING (Real Modern Split AC Photo) -->
    <a 
      href="/category/air-conditioners"
      id="panel-cooling"
      class="gateway-panel group relative flex-1 flex flex-col justify-between p-8 sm:p-12 md:p-14 border-b md:border-b-0 md:border-r border-[#1E293B] bg-gradient-to-br from-[#0A1628] via-[#091322] to-[#060D17] transition-all duration-500 ease-out cursor-pointer hover:flex-[1.35] overflow-hidden"
      onclick="localStorage.setItem('frostnet_preferred_theme', 'cooling')"
    >
      <!-- Real AC Hero Visual in Background -->
      <div class="absolute right-0 bottom-4 w-3/4 sm:w-2/3 md:w-3/5 h-2/3 pointer-events-none z-0 opacity-40 group-hover:opacity-75 group-hover:scale-105 transition-all duration-500 flex items-center justify-end pr-4 sm:pr-8">
        <img 
          src="/uploads/demo/hero-ac-modern.png" 
          alt="Modern Inverter Air Conditioner" 
          class="max-h-full object-contain drop-shadow-[0_20px_35px_rgba(2,132,199,0.35)]"
        />
      </div>

      <div class="relative z-10 max-w-sm sm:max-w-md">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0284C7]/20 border border-[#0284C7]/40 text-[#38BDF8] text-xs font-semibold tracking-wide uppercase mb-4 backdrop-blur-sm">
          <%- include('../partials/icons', { name: 'snowflake', className: 'w-3.5 h-3.5' }) %>
          Climate Solutions
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-3 font-['Plus_Jakarta_Sans']">
          Cooling
        </h2>
        <p class="text-[#94A3B8] text-sm sm:text-base leading-relaxed group-hover:text-white transition-colors drop-shadow">
          High-efficiency Inverter split systems, commercial cassettes, and whisper-quiet room climate units with verified warranty.
        </p>
      </div>

      <div class="relative z-10 pt-8 flex items-center justify-between border-t border-[#1E293B]/80 mt-12">
        <div>
          <span class="block text-2xl sm:text-3xl font-bold text-white font-mono"><%= acCat.product_count || 6 %></span>
          <span class="text-xs text-[#64748B] uppercase tracking-wider">Models in stock</span>
        </div>
        <div class="w-11 h-11 rounded-full bg-[#0284C7] text-white flex items-center justify-center group-hover:translate-x-1.5 transition-transform shadow-lg shadow-[#0284C7]/40">
          <%- include('../partials/icons', { name: 'arrow-right', className: 'w-5 h-5' }) %>
        </div>
      </div>
    </a>

    <!-- PANEL B: NETWORKING (Real Enterprise Switches & Access Points Photo) -->
    <a 
      href="/category/access-points"
      id="panel-networking"
      class="gateway-panel group relative flex-1 flex flex-col justify-between p-8 sm:p-12 md:p-14 bg-gradient-to-br from-[#12161A] via-[#0E1216] to-[#080B0E] transition-all duration-500 ease-out cursor-pointer hover:flex-[1.35] overflow-hidden"
      onclick="localStorage.setItem('frostnet_preferred_theme', 'networking')"
    >
      <!-- Real Networking Enterprise Visual in Background -->
      <div class="absolute right-0 bottom-4 w-3/4 sm:w-2/3 md:w-3/5 h-2/3 pointer-events-none z-0 opacity-40 group-hover:opacity-75 group-hover:scale-105 transition-all duration-500 flex items-center justify-end pr-4 sm:pr-8">
        <img 
          src="/uploads/demo/hero-networking-suite.jpg" 
          alt="Enterprise Access Points, Switches and Rack Systems" 
          class="max-h-full object-contain rounded-xl drop-shadow-[0_20px_35px_rgba(16,185,129,0.25)]"
        />
      </div>

      <div class="relative z-10 max-w-sm sm:max-w-md">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#10B981]/20 border border-[#10B981]/40 text-[#34D399] text-xs font-semibold tracking-wide uppercase mb-4 backdrop-blur-sm">
          <%- include('../partials/icons', { name: 'wifi', className: 'w-3.5 h-3.5' }) %>
          Enterprise Connectivity
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-3 font-['IBM_Plex_Sans']">
          Networking
        </h2>
        <p class="text-[#8B949E] text-sm sm:text-base leading-relaxed group-hover:text-white transition-colors drop-shadow">
          Carrier-grade Wi-Fi 6/6E access points, PoE rack switches, high-density controllers, and long-range outdoor wireless links.
        </p>
      </div>

      <div class="relative z-10 pt-8 flex items-center justify-between border-t border-[#30363D]/80 mt-12">
        <div>
          <span class="block text-2xl sm:text-3xl font-bold text-white font-mono"><%= apCat.product_count || 6 %></span>
          <span class="text-xs text-[#8B949E] uppercase tracking-wider">Models in stock</span>
        </div>
        <div class="w-11 h-11 rounded-full bg-[#10B981] text-[#042416] flex items-center justify-center group-hover:translate-x-1.5 transition-transform shadow-lg shadow-[#10B981]/40">
          <%- include('../partials/icons', { name: 'arrow-right', className: 'w-5 h-5' }) %>
        </div>
      </div>
    </a>

  </div>

  <!-- Gateway Trust Strip -->
  <div class="bg-[#080B11] border-y border-[#1E293B] py-3.5 px-6 text-xs text-[#64748B] flex flex-wrap items-center justify-between font-mono gap-3">
    <div class="flex items-center gap-4">
      <span>Direct Importer • Verified Serial Numbers & Manufacturer Warranty</span>
      <span class="hidden sm:inline">• Islandwide Insured Delivery</span>
    </div>
    <div class="flex items-center gap-4">
      <a href="/products" class="text-[#38BDF8] hover:underline">Complete Hardware Catalog →</a>
      <span class="text-[#334155]">|</span>
      <!-- Subtle Authorized Seller/Admin Portal Access -->
      <a href="/admin/login" class="inline-flex items-center gap-1.5 text-[#94A3B8] hover:text-[#38BDF8] transition-colors py-0.5 px-2 rounded bg-[#1E293B]/60 border border-[#334155]/60 text-[11px]" title="Authorized Personnel & Seller Portal Login">
        <%- include('../partials/icons', { name: 'lock', className: 'w-3 h-3 text-[#38BDF8]' }) %>
        <span>Seller / Admin Access</span>
      </a>
    </div>
  </div>

  <!-- SEO & DIRECT BROWSING SECTION: FEATURED AIR CONDITIONERS ON HOME PAGE -->
  <% 
    const acFeatured = (featured || []).filter(p => p.category_slug === 'air-conditioners');
    const acDisplayList = acFeatured.length > 0 ? acFeatured : (offers || []).filter(p => p.category_slug === 'air-conditioners');
  %>

  <section id="featured-ac" class="py-14 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4 pb-4 border-b border-[#1E293B]">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-[#38BDF8] mb-1.5">
          <%- include('../partials/icons', { name: 'snowflake', className: 'w-3.5 h-3.5' }) %>
          Immediate Inventory Available
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-['Plus_Jakarta_Sans'] text-white">
          Popular Air Conditioners (Inverter & Split Units)
        </h2>
        <p class="text-xs sm:text-sm text-[#94A3B8] mt-1">
          Explore BTU capacities, compare inverter savings, and chat on WhatsApp for fast invoice quotations.
        </p>
      </div>

      <a 
        href="/category/air-conditioners" 
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#38BDF8] hover:text-white transition-colors bg-[#1E293B] hover:bg-[#334155] border border-[#334155] px-3.5 py-2 rounded-lg self-start sm:self-auto"
      >
        <span>View All Air Conditioners</span>
        <span>→</span>
      </a>
    </div>

    <!-- Real AC Products Grid using actual photos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% acDisplayList.slice(0, 6).forEach(prod => { %>
        <%- include('../partials/product-card', { product: prod, currentTheme: 'cooling' }) %>
      <% }) %>
    </div>
  </section>

  <!-- Global Footer -->
  <%- include('../partials/footer') %>

</div>

<script>
  // Panel hover interaction: expand hovered panel, slightly dim sibling
  const coolingPanel = document.getElementById('panel-cooling');
  const networkingPanel = document.getElementById('panel-networking');

  if (coolingPanel && networkingPanel && window.innerWidth >= 768) {
    coolingPanel.addEventListener('mouseenter', () => {
      networkingPanel.style.opacity = '0.55';
    });
    coolingPanel.addEventListener('mouseleave', () => {
      networkingPanel.style.opacity = '1';
    });

    networkingPanel.addEventListener('mouseenter', () => {
      coolingPanel.style.opacity = '0.55';
    });
    networkingPanel.addEventListener('mouseleave', () => {
      coolingPanel.style.opacity = '1';
    });
  }
</script>
