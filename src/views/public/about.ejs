<div class="py-12 border-b border-[var(--theme-border)] bg-[var(--theme-bg-subtle)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl text-center">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--theme-text)] mb-3">About <%= settings.business_name %></h1>
    <p class="text-sm text-[var(--theme-text-muted)] leading-relaxed"><%= settings.tagline %></p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 max-w-4xl">
  <div class="th-card p-8 md:p-10 mb-10">
    <h2 class="text-2xl font-bold text-[var(--theme-text)] mb-4"><%= settings.about_title %></h2>
    <div class="space-y-4 text-sm text-[var(--theme-text-muted)] leading-relaxed">
      <p><%= settings.about_body %></p>
      <p>
        We supply genuine residential and commercial air conditioning units alongside high-density Wi-Fi 6/6E/7 wireless enterprise equipment across Sri Lanka. Every hardware shipment includes official manufacturer warranty documentation and pre-tested configurations.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
    <div class="th-card p-6">
      <div class="text-3xl font-bold text-[var(--theme-primary)] mb-1 font-mono">100%</div>
      <div class="font-bold text-sm text-[var(--theme-text)] mb-1">Genuine Hardware</div>
      <p class="text-xs text-[var(--theme-text-muted)]">Verified distributor serial numbers and factory warranties.</p>
    </div>
    <div class="th-card p-6">
      <div class="text-3xl font-bold text-[var(--theme-primary)] mb-1 font-mono">24h</div>
      <div class="font-bold text-sm text-[var(--theme-text)] mb-1">Direct Quotes</div>
      <p class="text-xs text-[var(--theme-text-muted)]">Instant WhatsApp estimates with volume B2B pricing.</p>
    </div>
    <div class="th-card p-6">
      <div class="text-3xl font-bold text-[var(--theme-primary)] mb-1 font-mono">9 Prov</div>
      <div class="font-bold text-sm text-[var(--theme-text)] mb-1">Islandwide Transit</div>
      <p class="text-xs text-[var(--theme-text-muted)]">Insured door-to-door delivery across Sri Lanka.</p>
    </div>
  </div>
</div>
