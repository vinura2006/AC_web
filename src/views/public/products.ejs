        <div>
          <nav class="text-xs font-mono text-[var(--theme-text-muted)] mb-2 flex items-center gap-2">
            <a href="/" class="hover:text-[var(--theme-text)]">Gateway</a>
            <span>/</span>
            <span class="text-[var(--theme-text)]">All Equipment</span>
          </nav>
          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--theme-text)]">
            <%= searchQuery ? `Search Results: "${searchQuery}"` : 'Complete Hardware Catalog' %>
          </h1>
          <p class="text-xs text-[var(--theme-text-muted)] mt-1">Direct distributor units across cooling and enterprise wireless infrastructure.</p>
        </div>
        <div class="text-xs font-mono text-[var(--theme-text-muted)]">
          Total: <span class="text-[var(--theme-primary)] font-bold"><%= products.length %></span> units
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% products.forEach(prod => { %>
        <%- include('../partials/product-card', { product: prod, currentTheme: prod.category_slug === 'air-conditioners' ? 'cooling' : 'networking' }) %>
      <% }) %>
    </div>
  </div>
<% } %>
