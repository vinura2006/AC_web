<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold font-['Plus_Jakarta_Sans'] text-white">Add New Hardware Item</h1>
      <p class="text-xs text-[#94A3B8] mt-1">Publish an Air Conditioner or Access Point to the public store.</p>
    </div>
    <a href="/admin" class="bg-[#334155] hover:bg-[#475569] text-white text-xs px-3 py-1.5 rounded-lg transition-colors">
      Back to Inventory
    </a>
  </div>

  <div class="bg-[#1E293B] border border-[#334155] rounded-xl p-6 md:p-8 shadow-lg">
    <form action="/admin/products/new" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Hardware Category</label>
        <select name="category_slug" class="w-full bg-[#0F172A] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white focus:border-[#38BDF8] outline-none" required>
          <option value="air-conditioners">Air Conditioners (Cooling)</option>
          <option value="access-points">Access Points (Networking)</option>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Brand Name</label>
          <input type="text" name="brand" placeholder="e.g. Daikin, Ubiquiti, LG" required class="w-full bg-[#0F172A] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white focus:border-[#38BDF8] outline-none" />
        </div>
        <div>
          <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Model Number</label>
          <input type="text" name="model" placeholder="e.g. FTKF35TV, U6-Pro" required class="w-full bg-[#0F172A] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white focus:border-[#38BDF8] outline-none" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Product Display Name</label>
        <input type="text" name="name" placeholder="e.g. Inverter Split AC 12000 BTU R32" required class="w-full bg-[#0F172A] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white focus:border-[#38BDF8] outline-none" />
      </div>

      <!-- Pricing & Interactive Discount Calculator -->
      <div class="p-4 rounded-xl bg-[#0F172A] border border-[#334155] space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Regular Price (LKR)</label>
            <input 
              type="number" 
              id="regular-price-input" 
              name="price" 
              placeholder="185000" 
              required 
              class="w-full bg-[#1E293B] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white font-mono focus:border-[#38BDF8] outline-none" 
            />
          </div>
          <div>
            <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Sale / Offer Price (LKR)</label>
            <input 
              type="number" 
              id="sale-price-input" 
              name="sale_price" 
              placeholder="Optional discount" 
              class="w-full bg-[#1E293B] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white font-mono focus:border-[#38BDF8] outline-none" 
            />
          </div>
          <div>
            <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Stock Count</label>
            <input 
              type="number" 
              name="stock_qty" 
              value="5" 
              min="0" 
              required 
              class="w-full bg-[#1E293B] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white font-mono focus:border-[#38BDF8] outline-none" 
            />
          </div>
        </div>

        <!-- Dynamic Live Discount Indicator -->
        <div id="discount-preview-box" class="hidden p-3 rounded-lg bg-[#EA580C]/10 border border-[#EA580C]/30 flex items-center justify-between text-xs">
          <div class="flex items-center gap-2">
            <span class="bg-[#EA580C] text-white font-bold text-xs px-2 py-0.5 rounded" id="discount-pct-badge">0% OFF</span>
            <span class="text-white font-medium" id="savings-amount-text">Price Drop: Rs 0</span>
          </div>
          <span class="text-[#94A3B8] font-mono text-[11px]">Customer pays: <strong class="text-[#38BDF8]" id="effective-price-text">Rs 0</strong></span>
        </div>
      </div>

      <div>
        <label class="block text-xs font-mono uppercase text-[#94A3B8] mb-1.5">Short Highlights Description</label>
        <textarea name="short_description" rows="3" placeholder="Summary specifications, warranty coverage, room size, or PoE details..." class="w-full bg-[#0F172A] border border-[#334155] rounded-lg px-3 py-2 text-sm text-white focus:border-[#38BDF8] outline-none"></textarea>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#334155]">
        <a href="/admin" class="bg-[#334155] hover:bg-[#475569] text-white text-xs px-4 py-2 rounded-lg transition-colors">Cancel</a>
        <button type="submit" class="bg-[#38BDF8] hover:bg-[#0EA5E9] text-[#0F172A] text-xs font-bold px-6 py-2.5 rounded-lg transition-colors">
          Save & Publish to Store
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const regInput = document.getElementById('regular-price-input');
  const saleInput = document.getElementById('sale-price-input');
  const previewBox = document.getElementById('discount-preview-box');
  const pctBadge = document.getElementById('discount-pct-badge');
  const savingsText = document.getElementById('savings-amount-text');
  const effectiveText = document.getElementById('effective-price-text');

  function updateDiscountPreview() {
    const reg = parseFloat(regInput.value) || 0;
    const sale = parseFloat(saleInput.value) || 0;

    if (reg > 0 && sale > 0 && sale < reg) {
      const savings = reg - sale;
      const pct = Math.round((savings / reg) * 100);

      pctBadge.textContent = '-' + pct + '% OFF';
      savingsText.textContent = 'Price Drop: Rs ' + savings.toLocaleString();
      effectiveText.textContent = 'Rs ' + sale.toLocaleString();
      previewBox.classList.remove('hidden');
    } else {
      previewBox.classList.add('hidden');
    }
  }

  regInput.addEventListener('input', updateDiscountPreview);
  saleInput.addEventListener('input', updateDiscountPreview);
</script>
