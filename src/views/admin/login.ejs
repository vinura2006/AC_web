<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Portal Sign In | FrostNet</title>
  <link rel="stylesheet" href="/css/output.css">
  <meta name="robots" content="noindex, nofollow">
</head>
<body class="bg-bg-base text-text min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md card p-8 border border-border shadow-2xl">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 border border-primary/30 text-primary mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold font-heading">Seller & Admin Console</h1>
      <p class="text-xs text-muted mt-1">Authorized personnel only</p>
    </div>

    <% if (error) { %>
      <div class="p-3 mb-6 rounded-lg bg-danger/10 border border-danger/30 text-danger text-xs text-center font-medium">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-mono uppercase text-muted mb-1.5">Email Address</label>
        <input type="email" name="email" required class="input" placeholder="admin@frostnet.lk" />
      </div>

      <div>
        <label class="block text-xs font-mono uppercase text-muted mb-1.5">Password</label>
        <input type="password" name="password" required class="input" placeholder="••••••••••••" />
      </div>

      <button type="submit" class="btn btn-primary w-full py-2.5 font-bold text-sm mt-6">
        Sign In to Portal
      </button>
    </form>

    <div class="mt-8 pt-4 border-t border-border/50 text-center">
      <a href="/" class="text-xs text-muted hover:text-primary transition-colors">← Back to Public Website</a>
    </div>
  </div>
</body>
</html>

