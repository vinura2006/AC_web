<!DOCTYPE html>
<html lang="en" data-theme="neutral">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? `${title} | Admin Console` : 'Admin Console' %></title>
  <link rel="stylesheet" href="/css/output.css">
  <meta name="robots" content="noindex, nofollow">
</head>
<body class="bg-[#0F172A] text-[#F8FAFC] min-h-screen flex flex-col font-['DM_Sans',sans-serif]">
  <!-- Clean Neutral Admin Top Bar -->
  <header class="bg-[#1E293B] border-b border-[#334155] sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="/admin" class="flex items-center gap-2 font-bold text-base text-white">
          <span class="w-2.5 h-2.5 rounded-full bg-[#38BDF8]"></span>
          FrostNet Console
        </a>
        <nav class="hidden md:flex items-center gap-4 text-xs font-medium pl-6 border-l border-[#334155]">
          <a href="/admin" class="text-white hover:text-[#38BDF8]">Inventory</a>
          <a href="/admin/products/new" class="text-[#38BDF8] font-bold">+ New Item</a>
          <a href="/" target="_blank" class="text-[#94A3B8] hover:text-white flex items-center gap-1">
            <span>Storefront</span>
            <span class="text-[10px]">↗</span>
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-3">
        <% if (locals.adminUser) { %>
          <span class="text-xs text-[#94A3B8] hidden sm:inline-block">
            <%= locals.adminUser.email %>
          </span>
          <a href="/admin/logout" class="text-xs bg-[#334155] hover:bg-[#475569] text-white px-3 py-1.5 rounded-lg transition-colors">
            Log Out
          </a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Content -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8">
    <%- body %>
  </main>
</body>
</html>
