<%# Theme-aware Product Card component %>
<% 
  const p = product;
  const pricing = p.pricing || { isOnOffer: false, currentPrice: p.price, originalPrice: p.price, discountPercent: 0 };
  const stock = p.stock || { status: 'in_stock', label: 'In stock', badgeClass: 'badge-success' };
  const imgUrl = p.thumb_url || p.image_url || '/uploads/demo/default.svg';
  const theme = typeof currentTheme !== 'undefined' ? currentTheme : (p.category_slug === 'access-points' ? 'networking' : 'cooling');
%>

<% if (theme === 'cooling') { %>
  <!-- ==========================================
       COOLING THEME CARD (Light, Friendly, Editorial)
       ========================================== -->
  <div 
    class="th-card flex flex-col h-full overflow-hidden group border border-[#DCE7F2] bg-white rounded-2xl hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
    data-btu="<%= (p.specs && p.specs.capacity_btu) ? p.specs.capacity_btu : '' %>"
    data-inverter="<%= (p.specs && p.specs.inverter) ? 'true' : 'false' %>"
    data-product-card
  >
    <!-- Product Visual with soft gradient backdrop -->
    <a href="/product/<%= p.slug %>" class="relative block aspect-[4/3] bg-gradient-to-b from-[#F0F7FF] to-[#E2EEF9] overflow-hidden p-6 flex items-center justify-center">
      <img 
        src="<%= imgUrl %>" 
        alt="<%= p.name %>" 
        loading="lazy" 
        width="400" 
        height="300"
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
      />
      
      <!-- Struck-Through Discount Hot Pill -->
      <% if (pricing.isOnOffer) { %>
        <span class="absolute top-3.5 left-3.5 bg-[#EA580C] text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-sm">
          Save <%= pricing.discountPercent %>%
        </span>
      <% } %>

      <!-- Stock pill -->
      <span class="absolute top-3.5 right-3.5 text-[11px] font-medium px-2.5 py-0.5 rounded-full <%= stock.inStock ? 'bg-[#ECFDF5] text-[#065F46] border border-[#A7F3D0]' : 'bg-[#FEF2F2] text-[#991B1B] border border-[#FECACA]' %>">
        <%= stock.label %>
      </span>
    </a>

    <!-- Card Content Area -->
    <div class="p-5 flex flex-col flex-grow">
      <div class="text-xs font-semibold text-[#0284C7] uppercase tracking-wider mb-1">
        <%= p.brand %> • <%= p.model %>
      </div>

      <a href="/product/<%= p.slug %>" class="font-['Plus_Jakarta_Sans'] font-bold text-[#0F2038] text-base group-hover:text-[#0284C7] transition-colors line-clamp-2 mb-3">
        <%= p.name %>
      </a>

      <!-- Key HVAC Badges (BTU & Inverter) -->
      <div class="flex flex-wrap gap-1.5 mb-4">
        <% if (p.specs && p.specs.capacity_btu) { %>
          <span class="inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-md bg-[#EDF4FA] text-[#0F2038] border border-[#DCE7F2]">
            <strong><%= p.specs.capacity_btu.toLocaleString() %> BTU</strong>
          </span>
        <% } %>
        <% if (p.specs && p.specs.inverter !== undefined) { %>
          <span class="inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-md <%= p.specs.inverter ? 'bg-[#F0FDF4] text-[#166534] border border-[#DCFCE7]' : 'bg-[#F8FAFC] text-[#64748B] border border-[#E2E8F0]' %>">
            <%= p.specs.inverter ? 'Inverter Eco' : 'Non-Inverter' %>
          </span>
        <% } %>
        <% if (p.specs && p.specs.type) { %>
          <span class="inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-md bg-[#F8FAFC] text-[#536B88] border border-[#E2E8F0]">
            <%= p.specs.type %> AC
          </span>
        <% } %>
      </div>

      <!-- Pricing & Direct Inquiry -->
      <div class="mt-auto pt-4 border-t border-[#EDF4FA] flex items-center justify-between gap-2">
        <div>
          <div class="flex items-baseline gap-2">
            <span class="text-xl font-bold font-['Plus_Jakarta_Sans'] text-[#0F2038]">
              <%= formatPrice(pricing.currentPrice) %>
            </span>
          </div>
          <% if (pricing.isOnOffer) { %>
            <div class="text-xs text-[#536B88] line-through">
              Was <%= formatPrice(pricing.originalPrice) %>
            </div>
          <% } %>
        </div>

        <a 
          href="<%= waLink(p.name, formatPrice(pricing.currentPrice)) %>" 
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="Request quote for <%= p.name %>"
          class="bg-[#25D366] hover:bg-[#20BA5A] text-white text-xs font-semibold px-3 py-2 rounded-xl flex items-center gap-1.5 transition-colors shadow-sm"
        >
          <%- include('./icons', { name: 'whatsapp', className: 'w-4 h-4' }) %>
          <span>Quote</span>
        </a>
      </div>
    </div>
  </div>

<% } else { %>
  <!-- ==========================================
       NETWORKING THEME CARD (Dark, Dense, Enterprise Datasheet)
       ========================================== -->
  <div 
    class="th-card flex flex-col h-full overflow-hidden border border-[#30363D] bg-[#161B22] rounded-[4px] hover:border-[#10B981]/60 transition-all duration-200 relative group"
    data-wifi="<%= (p.specs && p.specs.wifi_standard) ? p.specs.wifi_standard : '' %>"
    data-poe="<%= (p.specs && p.specs.poe) ? p.specs.poe : '' %>"
    data-brand="<%= p.brand %>"
    data-management="<%= (p.specs && p.specs.management) ? p.specs.management : '' %>"
    data-env="<%= (p.specs && p.specs.environment) ? p.specs.environment : '' %>"
    data-name="<%= p.name %>"
    data-id="<%= p.id %>"
    data-throughput="<%= (p.specs && p.specs.max_speed_mbps) ? p.specs.max_speed_mbps + ' Mbps' : 'N/A' %>"
    data-price="<%= formatPrice(pricing.currentPrice) %>"
    data-product-card
  >
    <!-- Compare checkbox in top-right -->
    <div class="absolute top-2 right-2 z-10 bg-[#0D1117]/90 px-1.5 py-0.5 rounded-[2px] border border-[#30363D] flex items-center gap-1 text-[10px] font-mono text-[#8B949E]">
      <input 
        type="checkbox" 
        id="cmp-<%= p.id %>" 
        onchange="toggleCompare('<%= p.id %>', '<%= p.name.replace(/'/g, \"\\'\") %>', '<%= p.brand %>', '<%= p.model %>', '<%= (p.specs && p.specs.wifi_standard) || 'N/A' %>', '<%= (p.specs && p.specs.poe) || 'N/A' %>', '<%= (p.specs && p.specs.max_speed_mbps) || 'N/A' %>', '<%= (p.specs && p.specs.environment) || 'Indoor' %>', '<%= formatPrice(pricing.currentPrice) %>', this)"
        class="compare-checkbox rounded-[2px] text-[#10B981] focus:ring-0 w-3 h-3 bg-[#161B22] border-[#30363D] cursor-pointer"
      />
      <label for="cmp-<%= p.id %>" class="cursor-pointer select-none">Compare</label>
    </div>

    <!-- Visual area with technical grid background -->
    <a href="/product/<%= p.slug %>" class="relative block aspect-[16/10] bg-[#0D1117] border-b border-[#30363D] p-4 flex items-center justify-center">
      <img 
        src="<%= imgUrl %>" 
        alt="<%= p.name %>" 
        loading="lazy" 
        width="400" 
        height="250"
        class="w-full h-full object-contain"
      />
      
      <% if (pricing.isOnOffer) { %>
        <span class="absolute top-2 left-2 bg-[#F59E0B] text-[#0D1117] text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-[2px]">
          PROMO -<%= pricing.discountPercent %>%
        </span>
      <% } %>

      <span class="absolute bottom-2 left-2 text-[10px] font-mono px-1.5 py-0.5 rounded-[2px] <%= stock.inStock ? 'bg-[#042416] text-[#10B981] border border-[#10B981]/40' : 'bg-[#310A0A] text-[#F87171] border border-[#F87171]/40' %>">
        <%= stock.label %>
      </span>
    </a>

    <!-- Datasheet spec grid -->
    <div class="p-3.5 flex flex-col flex-grow text-xs">
      <div class="flex items-center justify-between text-[11px] font-mono text-[#8B949E] mb-1">
        <span><%= p.brand %></span>
        <span class="text-[#F0F6FC] font-semibold"><%= p.model %></span>
      </div>

      <a href="/product/<%= p.slug %>" class="font-['IBM_Plex_Sans'] font-semibold text-[#F0F6FC] hover:text-[#10B981] line-clamp-2 mb-3">
        <%= p.name %>
      </a>

      <!-- Spec Table Chips -->
      <div class="space-y-1 font-mono text-[11px] mb-4 bg-[#0D1117] p-2 rounded-[3px] border border-[#21262D]">
        <% if (p.specs && p.specs.wifi_standard) { %>
          <div class="flex justify-between">
            <span class="text-[#8B949E]">Standard:</span>
            <span class="text-[#10B981] font-semibold"><%= p.specs.wifi_standard %></span>
          </div>
        <% } %>
        <% if (p.specs && p.specs.poe) { %>
          <div class="flex justify-between">
            <span class="text-[#8B949E]">PoE:</span>
            <span class="text-[#F0F6FC]"><%= p.specs.poe %></span>
          </div>
        <% } %>
        <% if (p.specs && p.specs.max_speed_mbps) { %>
          <div class="flex justify-between">
            <span class="text-[#8B949E]">Throughput:</span>
            <span class="text-[#F0F6FC]"><%= p.specs.max_speed_mbps %> Mbps</span>
          </div>
        <% } %>
      </div>

      <!-- Pricing Bar & Direct RFQ Action -->
      <div class="mt-auto pt-3 border-t border-[#30363D] flex items-center justify-between">
        <div>
          <div class="font-mono font-bold text-sm text-[#10B981]">
            <%= formatPrice(pricing.currentPrice) %>
          </div>
          <% if (pricing.isOnOffer) { %>
            <div class="text-[10px] font-mono text-[#8B949E] line-through">
              <%= formatPrice(pricing.originalPrice) %>
            </div>
          <% } %>
        </div>

        <a 
          href="<%= waLink(p.name, formatPrice(pricing.currentPrice)) %>" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-[#238636] hover:bg-[#2EA043] text-white font-mono text-xs px-3 py-1.5 rounded-[3px] transition-colors"
        >
          RFQ Quote
        </a>
      </div>
    </div>
  </div>
<% } %>
