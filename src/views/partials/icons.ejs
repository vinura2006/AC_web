<%# Reusable clean line icons (Lucide / Minimal Stroke style) %>
<% if (typeof name !== 'undefined') { %>
  <% const cls = typeof className !== 'undefined' ? className : 'w-5 h-5'; %>
  <% if (name === 'snowflake') { %>
    <svg class="<%= cls %>" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <line x1="12" y1="2" x2="12" y2="22"></line>
      <path d="m20 16-4-4 4-4"></path>
      <path d="m4 8 4 4-4 4"></path>
      <path d="m16 4-4 4-4-4"></path>
      <path d="m8 20 4-4 4 4"></path>
    </svg>
  <% } else if (name === 'wifi') { %>
    <svg class="<%= cls %>" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
      <path d="M12 20h.01"></path>
      <path d="M2 8.82a15 15 0 0 1 20 0"></path>
      <path d="M5 12.859a10 10 0 0 1 14 0"></path>
      <path d="M8.5 16.429a5 5 0 0 1 7 0"></path>
    </svg>
  <% } else if (name === 'whatsapp') { %>
    <svg class="<%= cls %>" fill="currentColor" viewBox="0 0 24 24">
